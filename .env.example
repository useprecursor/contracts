# Deployer key. Also the factory owner, and by default the fee recipient and the trusted verifier.
PRIVATE_KEY=

# Robinhood Chain RPC endpoints. The public endpoints are rate-limited; use a provider such as Alchemy for anything
# beyond a one-off deploy.
#   testnet: https://rpc.testnet.chain.robinhood.com  (chain id 46630)
#   mainnet: https://rpc.mainnet.chain.robinhood.com  (chain id 4663)
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_RPC=

# Blockscout verification
ROBINHOOD_TESTNET_BLOCKSCOUT_API=https://explorer.testnet.chain.robinhood.com/api
ROBINHOOD_BLOCKSCOUT_API=https://robinhoodchain.blockscout.com/api
BLOCKSCOUT_API_KEY=unused

# Stablecoin used for offerings, windows, RFQ and distributions. Leave blank off mainnet to deploy a 6-decimal
# test stablecoin. Required on mainnet.
USDG=

# Optional overrides (default to the deployer)
FEE_RECIPIENT=
DEFAULT_VERIFIER=

# Deploy the Northwind Labs demo company (default true off mainnet, false on mainnet)
DEPLOY_DEMO=true
